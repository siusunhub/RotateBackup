<Window x:Class="RotateBackup.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RotateBackup.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="RotateBackup Manager"
        Icon="/app.ico"
        Height="800"
        Width="1120"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area: Left Sidebar + Right Workspace -->
            <RowDefinition Height="*" />
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/app.ico"
                           Width="34"
                           Height="34"
                           Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" />
                    <TextBlock Text="RotateBackup Manager"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Top Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ New Backup Set"
                            Style="{StaticResource RoundedPrimaryButton}"
                            Command="{Binding NewBackupSetCommand}"
                            Margin="0,0,12,0" />
                    <Button Style="{StaticResource RoundedSuccessButton}"
                            Command="{Binding SaveAllCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14"
                                  Stretch="Uniform"
                                  Fill="#FFFFFF"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Data="F0 M5,2 C3.34,2 2,3.34 2,5 V19 C2,20.66 3.34,22 5,22 H19 C20.66,22 22,20.66 22,19 V7.41 C22,6.62 21.68,5.86 21.12,5.29 L18.71,2.88 C18.14,2.32 17.38,2 16.59,2 H5 Z M6,4 H15 V8 C15,8.55 14.55,9 14,9 H7 C6.45,9 6,8.55 6,8 V4 Z M18,13 V20 H6 V13 C6,12.45 6.45,12 7,12 H17 C17.55,12 18,12.45 18,13 Z M13,5 V8 H14 V5 H13 Z" />
                            <TextBlock Text="Save All Changes"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Left Sidebar (Sets List) + Right Tabs (Active Set Details) -->
        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: Backup Sets List -->
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="16" />
                <!-- Right Area: Active Set Header + Tabs -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Persistent List of Backup Sets -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Grid Margin="4,2,4,10">
                        <TextBlock Text="Backup Sets"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BackupSets.Count, StringFormat='({0})'}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- List of Sets -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding BackupSets}"
                             SelectedItem="{Binding SelectedBackupSet, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="Transparent"
                                                    BorderThickness="1.5"
                                                    BorderBrush="Transparent"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#E0F2FE" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Command}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Remark}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Background="{StaticResource CardSubtleBrush}"
                                                BorderBrush="{StaticResource BorderLightBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="6,2"
                                                Margin="0,0,0,2">
                                            <TextBlock Text="{Binding TypeDisplayName}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="Disabled"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   HorizontalAlignment="Right"
                                                   Visibility="{Binding Disabled, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Delete Button for Selected Set -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="4,10,4,2">
                        <Button Content="🗑 Delete Selected Set"
                                Style="{StaticResource RoundedDangerButton}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DeleteBackupSetCommand}" />
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT WORKSPACE: Active Backup Set Banner + Tabbed Settings -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Active Set Banner (Always visible on all tabs!) -->
                    <RowDefinition Height="Auto" />
                    <!-- Tabbed Configuration Panels -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ACTIVE SET BANNER -->
                <Border Grid.Row="0"
                        Style="{StaticResource ModernCard}"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource PrimaryAccentBrush}"
                        BorderThickness="1.5"
                        Padding="16,12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Active Backup Set:"
                                       FontWeight="Medium"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Border Background="#0284C7"
                                    CornerRadius="6"
                                    Padding="10,3"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding SelectedBackupSet.Command, FallbackValue='(None Selected)'}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="{Binding SelectedBackupSet.Remark}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       FontStyle="Italic" />
                        </StackPanel>

                        <!-- Type & Status Badges -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource CardSubtleBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,3"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding SelectedBackupSet.TypeDisplayName, StringFormat='Mode: {0}'}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TABBED SETTINGS (For the Active Backup Set) -->
                <TabControl Grid.Row="1"
                            Style="{StaticResource ModernTabControl}"
                            x:Name="MainTabs"
                            SelectionChanged="MainTabs_SelectionChanged"
                            Margin="0">

                    <!-- TAB 1: General Settings -->
                    <TabItem Header="⚙ General Settings">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <Border Style="{StaticResource ModernCard}" Padding="20">
                                <StackPanel DataContext="{Binding SelectedBackupSet}">
                                    <TextBlock Text="Backup Set Identity"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,0,0,16" />

                                    <!-- Command Alias -->
                                    <TextBlock Text="Command Name (Used in Task Scheduler / CLI):"
                                               FontWeight="Medium"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             Style="{StaticResource RoundedTextBox}"
                                             ToolTip="Only English letters, numbers, '_' and '-' are allowed."
                                             Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CommandNameError}"
                                               FontSize="11"
                                               Foreground="{StaticResource DangerBrush}"
                                               Margin="2,0,0,16"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasCommandNameError, Converter={StaticResource BoolToVis}}" />

                                    <!-- Remark -->
                                    <TextBlock Text="Remark / Description:"
                                               FontWeight="Medium"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource RoundedTextBox}"
                                             Margin="0,0,0,16" />

                                    <!-- Type: Directory or File -->
                                    <TextBlock Text="Rotation Type:"
                                               FontWeight="Medium"
                                               Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <RadioButton Content="📁 Directory Rotation"
                                                     IsChecked="{Binding IsDirectory, Mode=TwoWay}"
                                                     GroupName="RotationType"
                                                     Margin="0,0,28,0"
                                                     FontWeight="Medium" />
                                        <RadioButton Content="📄 Single File Rotation"
                                                     IsChecked="{Binding IsFile, Mode=TwoWay}"
                                                     GroupName="RotationType"
                                                     FontWeight="Medium" />
                                    </StackPanel>

                                    <!-- Activity Logging Configuration -->
                                    <Border Background="{StaticResource CardSubtleBrush}"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox Content="Create activity log file for this backup job"
                                                      IsChecked="{Binding EnableLog, Mode=TwoWay}"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,10" />

                                            <TextBlock Text="Log File Position / Path:"
                                                       FontWeight="Medium"
                                                       Margin="0,0,0,6"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RoundedTextBox}"
                                                         IsEnabled="{Binding EnableLog}" />
                                                <Button Grid.Column="1"
                                                        Content="Browse..."
                                                        Style="{StaticResource RoundedCompactButton}"
                                                        Click="BrowseLogPath_Click"
                                                        IsEnabled="{Binding EnableLog}"
                                                        Margin="8,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="Logs start time, processed folders/files, retry attempts, crash exceptions, and completion for each job separately."
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Status: Active / Disabled -->
                                    <Border Background="{StaticResource CardSubtleBrush}"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14">
                                        <StackPanel>
                                            <CheckBox Content="CRC Check for file copy complete"
                                                      IsChecked="{Binding EnableCrcCheck, Mode=TwoWay}"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      Margin="0,0,0,10" />
                                            <CheckBox Content="Disable this backup set"
                                                      IsChecked="{Binding Disabled, Mode=TwoWay}"
                                                      Style="{StaticResource ModernCheckBox}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Execution Log Maintenance -->
                                    <Border Background="{StaticResource CardSubtleBrush}"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Execution Log Maintenance"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="Every backup run is recorded in a shared log file with its start time, end time and result. Remove entries older than 30 days to keep the file small."
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10" />
                                            <Button Content="🧹 Clean Execution Log (30+ days)"
                                                    Style="{StaticResource RoundedSecondaryButton}"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.CleanupExecutionLogCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: Rotation Paths -->
                    <TabItem Header="📁 Rotation Paths">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel DataContext="{Binding SelectedBackupSet}">

                                <!-- Source Path Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Source Target"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,12" />

                                        <TextBlock Text="Source Folder / File Path to rotate:"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource RoundedTextBox}" />
                                            <Button Grid.Column="1"
                                                    Content="Browse..."
                                                    Style="{StaticResource RoundedCompactButton}"
                                                    Click="BrowseSourcePath_Click"
                                                    Margin="8,0,0,0" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Keep Source (Do not delete/move source after copying to slot 1)"
                                                      IsChecked="{Binding KeepSource, Mode=TwoWay}"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      Margin="0,0,24,0" />
                                            <CheckBox Content="Keep First Directory"
                                                      IsChecked="{Binding KeepFirstDir, Mode=TwoWay}"
                                                      Style="{StaticResource ModernCheckBox}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Generator Toolbar Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16" Background="{StaticResource CardSubtleBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Path Auto-Fill &amp; Folder Management Utility"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Margin="0,0,0,10" />

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Reference Path Input -->
                                            <TextBox Text="{Binding DataContext.ReferencePath, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource RoundedTextBox}"
                                                     ToolTip="Base reference path, e.g. D:\Backups\Daily"
                                                     VerticalAlignment="Center" />

                                            <!-- Slot Count -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="Rolls:" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,6,0" />
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableRollCounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding DataContext.SlotCountSelection, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                          Width="65"
                                                          VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Auto Fill Button -->
                                            <Button Grid.Column="2"
                                                    Content="⚡ Auto-Fill 1..N"
                                                    Style="{StaticResource RoundedPrimaryButton}"
                                                    Command="{Binding DataContext.AutoFillSlotsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="0,0,8,0" />

                                            <!-- Create Missing Folders Button -->
                                            <Button Grid.Column="3"
                                                    Content="📁 Create Folders"
                                                    Style="{StaticResource RoundedSecondaryButton}"
                                                    Command="{Binding DataContext.CreateMissingFoldersCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Rotation Slots List -->
                                <Border Style="{StaticResource ModernCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Destination Rotation Slots"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="＋ Add Slot"
                                                    Style="{StaticResource RoundedPrimaryButton}"
                                                    Command="{Binding DataContext.AddSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Padding="12,4" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                            BorderThickness="1"
                                                            BorderBrush="Transparent"
                                                            CornerRadius="6"
                                                            Padding="4,2"
                                                            Margin="0,2"
                                                            AllowDrop="True"
                                                            DragOver="SlotRow_DragOver"
                                                            DragEnter="SlotRow_DragEnter"
                                                            DragLeave="SlotRow_DragLeave"
                                                            Drop="SlotRow_Drop">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Drag Up/Down Icon Handle -->
                                                            <Border Grid.Column="0"
                                                                    Background="Transparent"
                                                                    CornerRadius="4"
                                                                    Cursor="SizeNS"
                                                                    Padding="6,6"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="Drag up/down to reorder this slot (or right-click)"
                                                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                                    PreviewMouseMove="DragHandle_PreviewMouseMove">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Opacity" Value="0.65" />
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Opacity" Value="1.0" />
                                                                                <Setter Property="Background" Value="#EEF2F6" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Border.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Move Up (▲)" Click="MoveSlotUp_Click" />
                                                                        <MenuItem Header="Move Down (▼)" Click="MoveSlotDown_Click" />
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Path Width="10" Height="14"
                                                                      Stretch="Uniform"
                                                                      Fill="{StaticResource TextSecondaryBrush}"
                                                                      Data="F0 M7,1 L11,5 L8.5,5 L8.5,10 L11,10 L7,14 L3,10 L5.5,10 L5.5,5 L3,5 Z" />
                                                            </Border>

                                                            <!-- Slot Badge -->
                                                            <Border Grid.Column="1"
                                                                    Background="#E0F2FE"
                                                                    CornerRadius="6"
                                                                    Padding="8,4"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Index, StringFormat='Slot #{0}'}"
                                                                           FontWeight="Bold"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource PrimaryAccentBrush}" />
                                                            </Border>

                                                            <!-- Slot Path -->
                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource RoundedTextBox}"
                                                                     Margin="8,0" />

                                                            <!-- Browse Button -->
                                                            <Button Grid.Column="3"
                                                                    Content="Browse..."
                                                                    Style="{StaticResource RoundedCompactButton}"
                                                                    Click="BrowseSlotPath_Click"
                                                                    Margin="0,0,12,0" />

                                                            <!-- Keep Checkbox -->
                                                            <CheckBox Grid.Column="4"
                                                                      Content="Keep"
                                                                      IsChecked="{Binding Keep, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernCheckBox}"
                                                                      ToolTip="Preserve existing contents instead of purging during rotation"
                                                                      Margin="0,0,8,0" />

                                                            <!-- Delete Slot Button -->
                                                            <Button Grid.Column="5"
                                                                    Content="✕"
                                                                    ToolTip="Delete this slot"
                                                                    Style="{StaticResource RoundedCompactButton}"
                                                                    Command="{Binding DataContext.DeleteSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="8,4"
                                                                    Foreground="#DC2626" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: Scripts & Execution -->
                    <TabItem Header="▶ Scripts &amp; Execution">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel DataContext="{Binding SelectedBackupSet}">

                                <!-- Pre & Post Commands Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Script Hooks"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,12" />

                                        <!-- Pre Command -->
                                        <TextBlock Text="Pre-Rotation Command (Executes before backup starts. Non-zero exit code halts rotation):"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,6" />
                                        <TextBox Text="{Binding PreCommand, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RoundedTextBox}"
                                                 Margin="0,0,0,16" />

                                        <!-- Post Command -->
                                        <TextBlock Text="Post-Rotation Command (Executes after rotation finishes successfully):"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,6" />
                                        <TextBox Text="{Binding PostCommand, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource RoundedTextBox}" />
                                    </StackPanel>
                                </Border>

                                <!-- Task Scheduler Command Card -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16" Background="{StaticResource CardSubtleBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Task Scheduler Integration"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="Command line for automated Windows Task Scheduler tasks:"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,8" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding CliCommandSnippet, Mode=OneWay}"
                                                     Style="{StaticResource RoundedTextBox}"
                                                     IsReadOnly="True"
                                                     Background="#F8FAFC" />
                                            <Button Grid.Column="1"
                                                    Content="📋 Copy Command"
                                                    Style="{StaticResource RoundedPrimaryButton}"
                                                    Command="{Binding DataContext.CopyCliSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Test Execution & Live Log Card -->
                                <Border Style="{StaticResource ModernCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▶ Test Run Backup Now"
                                                        Style="{StaticResource RoundedPrimaryButton}"
                                                        Command="{Binding DataContext.TestRunBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Margin="0,0,12,0" />
                                                <Button Content="Clear Logs"
                                                        Style="{StaticResource RoundedCompactButton}"
                                                        Command="{Binding DataContext.ClearLogsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>

                                            <ProgressBar Grid.Column="1"
                                                         IsIndeterminate="{Binding DataContext.IsRunningBackup, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Visibility="{Binding DataContext.IsRunningBackup, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                                         Width="140"
                                                         Height="10" />
                                        </Grid>

                                        <!-- Live Log Viewer (Light Theme) -->
                                        <Border Background="#F8FAFC"
                                                BorderBrush="{StaticResource BorderLightBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                MinHeight="180"
                                                MaxHeight="260">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding DataContext.ExecutionLogs, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                                                       FontSize="12"
                                                                       Foreground="#1E293B"
                                                                       Margin="0,1.5"
                                                                       TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 4: Execution Log (start time / end time / result of every execution) -->
                    <TabItem Header="📋 Execution Log">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Border Style="{StaticResource ModernCard}" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Job:"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <Border Background="#E0F2FE"
                                                CornerRadius="6"
                                                Padding="10,3">
                                            <TextBlock Text="{Binding SelectedBackupSet.Command, FallbackValue='(No set selected)'}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource PrimaryAccentBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ExecutionLogSummary}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,0,0" />

                                    <Button Grid.Column="2"
                                            Content="🔄 Refresh"
                                            Style="{StaticResource RoundedSecondaryButton}"
                                            Command="{Binding RefreshExecutionLogCommand}"
                                            Margin="0,0,8,0" />

                                    <Button Grid.Column="3"
                                            Content="📂 Open Folder"
                                            Style="{StaticResource RoundedCompactButton}"
                                            Command="{Binding OpenExecutionLogFolderCommand}" />
                                </Grid>
                            </Border>

                            <!-- Execution History Table -->
                            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Table Header -->
                                    <Grid Margin="16,14,16,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="STARTED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="ENDED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="DURATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="RESULT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="4" Text="COMMAND" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="5" Text="SOURCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>

                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding ExecutionHistory}"
                                             SelectedItem="{Binding SelectedExecutionRecord, Mode=TwoWay}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Margin="0,0,0,10"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="16,6" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="itemBorder"
                                                                    Background="Transparent"
                                                                    BorderThickness="0,0,0,1"
                                                                    BorderBrush="{StaticResource BorderLightBrush}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="itemBorder" Property="Background" Value="#E0F2FE" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding StartedAtDisplay}"
                                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding EndedAtDisplay}"
                                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DurationDisplay}"
                                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding ResultDisplay}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding ResultBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding Command}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding Source}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Empty State -->
                                    <TextBlock Grid.Row="1"
                                               Text="No execution recorded yet for this backup set. Run it from the CLI or with Test Run to create the first entry."
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="24"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasNoExecutionHistory, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <!-- Detail of the selected execution -->
                            <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Execution Detail"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Margin="0,0,0,8" />
                                    <TextBox Text="{Binding ExecutionLogDetail, Mode=OneWay}"
                                             Style="{StaticResource RoundedTextBox}"
                                             IsReadOnly="True"
                                             Background="#F8FAFC"
                                             FontFamily="Consolas, Cascadia Code, Courier New"
                                             FontSize="12"
                                             MinHeight="90"
                                             MaxHeight="110"
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>


        <!-- Footer Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v0.2"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryAccentBrush}" />
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding BackupSets.Count, StringFormat='Total Sets: {0}'}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
